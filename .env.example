# Copy to .env and fill in values for local development:
#   cp .env.example .env

APP_ENV=local

# Required — generate your own values; do not commit real secrets
SECRET_KEY=replace-with-local-secret
JWT_SECRET_KEY=replace-with-local-jwt-secret

# Optional locally 
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db

# Optional (defaults to http://localhost:3000,http://127.0.0.1:3000)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
